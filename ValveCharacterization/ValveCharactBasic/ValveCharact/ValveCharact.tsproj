<?xml version="1.0"?>
<TcSmProject xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.beckhoff.com/schemas/2012/07/TcSmProject" TcSmVersion="1.0" TcVersion="3.1.4026.30">
	<DataTypes>
		<DataType>
			<Name GUID="{2719D350-A47B-4785-A4FF-7C5A014A4ACB}" Namespace="MC" TcBaseType="true">EMcTaskInternalSequence</Name>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[FastReaction]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Execution order: Commands - Exec - Output. Processes new commands before output update, providing the fastest reaction to new commands.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Stable]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Execution order: Output - Commands - Exec. Output update is executed first, then new commands are processed, providing less jitter for output update.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_strict</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
			<Hides>
				<Hide GUID="{B4BE03D8-1304-440C-AA14-D00591C7909E}"/>
			</Hides>
		</DataType>
		<DataType>
			<Name GUID="{F20289EE-8CFB-4862-83EA-993DF40C82DE}" Namespace="MC" TcBaseType="true">EPositionUnit</Name>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[um]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Micrometers]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[mm]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Millimeters]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[m]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Meters]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[in]]></Text>
				<Enum>3</Enum>
				<Comment><![CDATA[Inches]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[deg]]></Text>
				<Enum>11</Enum>
				<Comment><![CDATA[Degrees (360 per revolution)]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[rad]]></Text>
				<Enum>12</Enum>
				<Comment><![CDATA[Radians (2*pi per revolution)]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[gon]]></Text>
				<Enum>13</Enum>
				<Comment><![CDATA[Gradians (400 per revolution)]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_strict</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
			<Hides>
				<Hide GUID="{F8DF3D26-7348-4D82-B440-871A2569A9CA}"/>
			</Hides>
		</DataType>
		<DataType>
			<Name GUID="{275BA82D-1BAC-4C3A-8408-35D279770DBC}" Namespace="MC" TcBaseType="true">EAxisLicenseSetting</Name>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[AutoBeckhoff]]></Text>
				<Enum>1</Enum>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[AutoMultiVendor]]></Text>
				<Enum>3</Enum>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Beckhoff]]></Text>
				<Enum>5</Enum>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[MultiVendor]]></Text>
				<Enum>7</Enum>
			</EnumInfo>
			<Hides>
				<Hide GUID="{96A4507A-2DFA-42BB-92D1-87BD27945C76}"/>
