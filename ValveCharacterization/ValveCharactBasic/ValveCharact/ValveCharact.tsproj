		</DataType>
		<DataType>
			<Name GUID="{15F9F152-5D43-412E-AD2A-4BB310063E1F}" Namespace="MC" TcBaseType="true">EPositionLagSource</Name>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[HardwareProvidedIfAvailable]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Uses hardware-provided position lag if available, otherwise falls back to internal calculation.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[InternallyCalculated]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Position lag is always calculated internally from position of setpoint and actual position.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[HardwareProvided]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Position lag is always taken from hardware. Requires hardware support and mapping.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_strict</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
			<Hides>
				<Hide GUID="{A34830D2-998F-4D0F-8700-2BD0F033CB00}"/>
				<Hide GUID="{3842D0A6-F7A4-4C48-99A7-E3BD90CDDC18}"/>
			</Hides>
		</DataType>
		<DataType>
			<Name GUID="{97C908A3-4B5E-4ADC-A209-4870A43AE2BA}">OTCID_PositionEncoder</Name>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-00000000000F}">OTCID</BaseType>
			<Properties>
				<Property>
					<Name>OTCID</Name>
				</Property>
				<Property>
					<Name>TcCategoryOID</Name>
					<Value>McPositionEncoder</Value>
				</Property>
			</Properties>
		</DataType>
		<DataType>
			<Name GUID="{CF9F9285-BE5D-469F-BB76-FE58A946F660}" Namespace="MC" TcBaseType="true">ELoadType</Name>
			<Comment><![CDATA[Indicates the type of the currently selected load of the axis.]]></Comment>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[None]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[No load control active.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Torque]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Load control based on torque.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Force]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Load control based on force.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[PressureA]]></Text>
				<Enum>3</Enum>
				<Comment><![CDATA[Load control based on pressure at area A of the cylinder.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[PressureB]]></Text>
				<Enum>4</Enum>
				<Comment><![CDATA[Load control based on pressure at area B of the cylinder.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[DirectVelocityOutput]]></Text>
				<Enum>5</Enum>
				<Comment><![CDATA[Velocity setpoint is written directly to the drive output.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_strict</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
			<Hides>
				<Hide GUID="{C30BA4E3-B1A6-4607-B389-710F8A9F5693}"/>
			</Hides>
		</DataType>
		<DataType>
			<Name GUID="{9D7C5BB7-932E-4E77-B852-A62F4DED3D78}" Namespace="MC" TcBaseType="true">EControlErrorSetpointMode</Name>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[HardStop]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[The dynamics of the axis are set to zero.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_strict</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
			<Hides>
				<Hide GUID="{2E8170EA-B8F4-4F89-B712-A841CCD70CC8}"/>
			</Hides>
		</DataType>
		<DataType>
			<Name GUID="{928ACD6D-34F6-4728-BC12-CB3937EB34C2}" Namespace="MC" TcBaseType="true">CDT_PLCTOMC_AXIS_STD</Name>
			<BitSize>192</BitSize>
			<SubItem>
				<Name>Enable</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[Enables the axis power stage.]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>EnablePositive</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[Allows motion in positive direction when TRUE.]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>8</BitOffs>
			</SubItem>
			<SubItem>
				<Name>EnableNegative</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[Allows motion in negative direction when TRUE.]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>16</BitOffs>
			</SubItem>
			<Hides>
				<Hide GUID="{83F84DB6-EBE2-4013-96D4-729A54553EDC}"/>
				<Hide GUID="{EC5954F8-EAC3-4E8C-BB06-1CA66ACC17DB}"/>
				<Hide GUID="{5A944F05-2D7C-4FD6-9ABA-134068F48E38}"/>
				<Hide GUID="{BDE5BC28-38E9-438E-81EF-FD1285D93E36}"/>
				<Hide GUID="{EA17B579-BF0B-4FD1-AC82-39E95C687EDE}"/>
			</Hides>
			<Relations>
				<Relation>
					<Type GUID="{83F84DB6-EBE2-4013-96D4-729A54553EDC}">DeprecatedName</Type>
