		</DataType>
		<DataType>
			<Name GUID="{3F34B9FE-8221-4E5F-824C-95044829EF5D}" Namespace="MC" TcBaseType="true">EFilterType</Name>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[None]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[No filtering applied.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[PT1]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[First-order low-pass filter.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[MovingAverage]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Moving average filter that smooths over a configurable number of samples.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[KalmanFilter3x1]]></Text>
				<Enum>3</Enum>
				<Comment><![CDATA[Kalman filter with 3-state model.]]></Comment>
			</EnumInfo>
