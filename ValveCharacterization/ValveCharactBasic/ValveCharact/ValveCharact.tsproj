									</Value>
									<Value>
										<Name>Filter Time Load Second Derivative</Name>
										<Value>0.01</Value>
									</Value>
									<Value>
										<Name>Filter Time</Name>
										<Value>0.001</Value>
									</Value>
								</ParameterValues>
							</TmcDesc>
