<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="MAIN" Id="{f3e01bea-890b-4845-9c29-b7bdf06da229}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR  
	/// the filepath '/temp/ValveCharacteristicCurve.csv' requests the folder 'temp' in C:\
  
    (* Configuration *)
    bUseComma : BOOL;
    
    (* Controls *)
    bStartWrite : BOOL;
    bStartRead  : BOOL;
    
    fbRead  : MC_ValveCharacteristicCurve_ReadFromCsv;
    fbWrite : MC_ValveCharacteristicCurve_WriteToCsv;
    WriteData : ARRAY[1..5] OF ValveCharacteristicPoint := [(Velocity:=-1.0, SpoolPosition:=-1.0), (Velocity:=-0.8, SpoolPosition:=-0.5), (Velocity:=0.0, SpoolPosition:=0.0), (Velocity:=0.4, SpoolPosition:=0.5), (Velocity:=0.8, SpoolPosition:=1.0)];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* Set CSV field separator to ';' (16#3B) for comma decimals, or ',' (16#2C) otherwise *)
IF bUseComma THEN
	DEFAULT_CSV_FIELD_SEP := 16#2C; (* Comma *)
ELSE
    DEFAULT_CSV_FIELD_SEP := 16#3B; (* Semicolon *)
END_IF

IF bStartWrite THEN
    bStartWrite:=FALSE;
    fbWrite.Write:=TRUE;
    fbWrite.FilePath:='/temp/ValveCharacteristicCurve.csv';
END_IF

IF bStartRead THEN
    bStartRead:=FALSE;
    fbRead.Read:=TRUE;
    fbRead.FilePath:='/temp/ValveCharacteristicCurve.csv';
END_IF

fbWrite(DataPoints:=WriteData);
fbRead();]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>